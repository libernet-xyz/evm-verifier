pragma solidity ^0.8.28;

import "./BlueSky.sol";
import "./Keccak256Hash.sol";
import "./Merkle.sol";

/// @notice The Merkle root hashes of a FRI commitment.
/// @dev roots[0] is the root of the main Merkle tree and roots[k] is the root of the tree from the
///   k-th folding round. Matches `starkom_pcs::fri::Commitment`.
struct FriCommitment {
    bytes32[] roots;
}

/// @notice The pair of Merkle proofs of one FRI folding round.
/// @dev `left` opens the queried index and `right` opens its partner, half a domain away.
struct FriFold {
    LeafProof left;
    LeafProof right;
}

/// @notice A single FRI query.
/// @dev Matches the `Query` protobuf. The degree bound and the blowup factor are not part of it
///   because all the queries of a proof share them.
struct FriQuery {
    /// @dev The queried index in the extended domain.
    uint256 index;
    /// @dev One pair of Merkle proofs for every Merkle tree of the folding argument. folds[0]
    ///   proves the opened values.
    FriFold[] folds;
}

/// @title FriVerifier
/// @notice Verifies FRI queries generated by `starkom-pcs` 8.0.1 with the Keccak-256 hash backend
///   over the BlueSky field.
library FriVerifier {
    using BlueSky for uint256;

    /// @dev Reverted when the degree bound is not a power of 2.
    error InvalidDegreeBound(uint256 degreeBound);

    /// @dev Reverted when the base-2 logarithm of the blowup factor is zero.
    error InvalidBlowupFactor();

    /// @dev Reverted when the extended domain doesn't fit in the 2-adicity of the field.
    error DomainTooLarge(uint256 degreeBoundLog2, uint256 blowupLog2);

    /// @dev Reverted when the query has no folds.
    error NoFolds();

    /// @dev Reverted when the query index is outside the extended domain.
    error InvalidQueryIndex(uint256 index, uint256 domainSize);

    /// @dev Reverted when the query has more folds than the degree bound allows.
    error IncorrectProofSize();

    /// @dev Reverted when the numbers of folds and commitment roots differ.
    error WrongNumberOfFoldingRounds();

    /// @dev Reverted when a left-hand side Merkle path has the wrong height.
    error InvalidLeftProofHeight(uint256 got, uint256 want);

    /// @dev Reverted when a right-hand side Merkle path has the wrong height.
    error InvalidRightProofHeight(uint256 got, uint256 want);

    /// @dev Reverted when the left-hand side leaf of a round differs from the previous fold.
    error LeafValueMismatch();

    /// @dev Reverted when a right-hand side leaf has the wrong number of values.
    error InvalidRightLeafSize(uint256 got, uint256 want);

    /// @dev Reverted when the polynomials of the last round are not constant.
    error FinalPolynomialNotConstant();

    /// @dev Domain separator for the folding challenges: `SHA3-256("starkom/fri/fold")`.
    bytes32 constant FOLD_DST =
        0x9ffd3556faeb2cae194ce95adf6b3580f590504daa0dea56966ce4ef233844af;

    /// @notice Derives the folding challenge of a round from the Merkle root of that round.
    function foldingChallenge(
        bytes32 rootHash
    ) internal pure returns (uint256) {
        bytes32[] memory transcript = new bytes32[](1);
        transcript[0] = rootHash;
        return Keccak256Hash.challenge(FOLD_DST, transcript);
    }

    /// @notice Verifies a FRI query against a commitment, reverting if it's invalid.
    /// @dev Performs the checks of both `Query::from_proto` and `Query::verify`.
    ///
    ///   For low-degree testing the caller must also check that `query.folds.length` equals
    ///   log2(degreeBound) + 1, as this function only verifies the opened values across the folding
    ///   structure.
    ///
    ///   Unlike the Rust implementation, which computes omega^(-index) with a separate
    ///   exponentiation in every round, this function computes it only once and squares it in every
    ///   subsequent round. The two are equivalent: if `step` is the inverse of a primitive 2^k-th
    ///   root of unity, `step^(index mod 2^(k-1))` in the next round equals
    ///   `(step^2)^index = (step^index)^2` because `step^2` has order 2^(k-1).
    /// @param degreeBound The degree bound of the committed polynomials, a power of 2.
    /// @param blowupLog2 The base-2 logarithm of the blowup factor, greater than 0.
    /// @param query The query to verify.
    /// @param commitment The commitment containing the Merkle root of every folding round.
    function verifyQuery(
        uint256 degreeBound,
        uint256 blowupLog2,
        FriQuery memory query,
        FriCommitment memory commitment
    ) internal view {
        uint256 degreeBoundLog2 = _validate(degreeBound, blowupLog2, query);

        // Checks from `Query::verify`.
        FriFold[] memory folds = query.folds;
        uint256 numFolds = folds.length;
        uint256 k = degreeBoundLog2 + blowupLog2;
        uint256 n = 1 << k;
        uint256 index = query.index;
        if (index >= n) {
            revert InvalidQueryIndex(index, n);
        }
        if (numFolds > degreeBoundLog2 + 1) {
            revert IncorrectProofSize();
        }
        bytes32[] memory roots = commitment.roots;
        if (roots.length != numFolds) {
            revert WrongNumberOfFoldingRounds();
        }

        // Copy the opened values because we fold them in place.
        uint256[] memory positive = _copy(folds[0].left.leaf);

        // omega^(-index), with omega being the primitive n-th root of unity. Here index < 2^k so
        // the exponent is less than 2^S.
        uint256 omegaInverse = BlueSky.ROOT_OF_UNITY_INV.pow(
            index << (BlueSky.S - k)
        );

        for (uint256 round = 0; round < numFolds; round++) {
            bytes32 rootHash = roots[round];
            uint256[] memory negative = _verifyRound(
                folds[round],
                positive,
                index,
                k,
                rootHash
            );
            n /= 2;
            k -= 1;
            index %= n;
            _fold(
                positive,
                negative,
                foldingChallenge(rootHash).mul(omegaInverse)
            );
            omegaInverse = omegaInverse.square();
        }

        FriFold memory last = folds[numFolds - 1];
        if (!Merkle.isConstant(last.left) || !Merkle.isConstant(last.right)) {
            revert FinalPolynomialNotConstant();
        }
    }

    /// @dev Performs the checks of `Query::from_proto` and returns log2(degreeBound).
    function _validate(
        uint256 degreeBound,
        uint256 blowupLog2,
        FriQuery memory query
    ) private pure returns (uint256 degreeBoundLog2) {
        if (degreeBound == 0 || degreeBound & (degreeBound - 1) != 0) {
            revert InvalidDegreeBound(degreeBound);
        }
        if (blowupLog2 == 0) {
            revert InvalidBlowupFactor();
        }
        degreeBoundLog2 = _log2(degreeBound);
        if (degreeBoundLog2 + blowupLog2 > BlueSky.S) {
            revert DomainTooLarge(degreeBoundLog2, blowupLog2);
        }
        FriFold[] memory folds = query.folds;
        if (folds.length == 0) {
            revert NoFolds();
        }
        for (uint256 round = 0; round < folds.length; round++) {
            Merkle.validate(folds[round].left);
            Merkle.validate(folds[round].right);
        }
    }

    /// @dev Performs the checks of one round of `Query::verify` and returns the opened partner
    ///   values. `positive` holds the values expected in the left-hand side leaf, `index` is the
    ///   queried index in the current domain, and `k` is the log2 of the current domain size.
    function _verifyRound(
        FriFold memory fold,
        uint256[] memory positive,
        uint256 index,
        uint256 k,
        bytes32 rootHash
    ) private pure returns (uint256[] memory negative) {
        LeafProof memory left = fold.left;
        LeafProof memory right = fold.right;
        if (left.path.length != k) {
            revert InvalidLeftProofHeight(left.path.length, k);
        }
        if (right.path.length != k) {
            revert InvalidRightProofHeight(right.path.length, k);
        }
        uint256[] memory leftLeaf = left.leaf;
        uint256 numPolys = positive.length;
        if (leftLeaf.length != numPolys) {
            revert LeafValueMismatch();
        }
        for (uint256 i = 0; i < numPolys; i++) {
            if (leftLeaf[i] != positive[i]) {
                revert LeafValueMismatch();
            }
        }
        negative = right.leaf;
        if (negative.length != numPolys) {
            revert InvalidRightLeafSize(negative.length, numPolys);
        }
        uint256 n = 1 << k;
        Merkle.verify(left, index, rootHash);
        Merkle.verify(right, (index + n / 2) % n, rootHash);
    }

    /// @dev Folds the `positive` values in place with their `negative` partners:
    ///   positive = (positive + negative + alphaOmegaInverse * (positive - negative)) / 2.
    function _fold(
        uint256[] memory positive,
        uint256[] memory negative,
        uint256 alphaOmegaInverse
    ) private pure {
        for (uint256 i = 0; i < positive.length; i++) {
            uint256 positiveValue = positive[i];
            uint256 negativeValue = negative[i];
            positive[i] = positiveValue
                .add(negativeValue)
                .add(alphaOmegaInverse.mul(positiveValue.sub(negativeValue)))
                .mul(BlueSky.TWO_INV);
        }
    }

    /// @dev Returns a copy of a memory array.
    function _copy(
        uint256[] memory values
    ) private pure returns (uint256[] memory result) {
        result = new uint256[](values.length);
        for (uint256 i = 0; i < values.length; i++) {
            result[i] = values[i];
        }
    }

    /// @dev Returns log2(n) for a power of 2 n.
    function _log2(uint256 n) private pure returns (uint256 result) {
        while (n > 1) {
            n >>= 1;
            result++;
        }
    }
}
