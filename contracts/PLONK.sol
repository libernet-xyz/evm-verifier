pragma solidity ^0.8.28;

import "@starkom/bluesky-sol/contracts/BlueSky.sol";
import "./DEEP.sol";
import "./Keccak256Hash.sol";
import "./ProofViewer.sol";

/// @notice A cell of a circuit, identified by its row and its column.
struct PlonkCell {
  uint256 row;
  uint256 column;
}

/// @notice What the verifier needs to know about a circuit to read and verify its proofs, i.e. the
///   parts of a `CompressedCircuit` of `starkom-plonk` other than the gates.
/// @dev The circuit is over the BlueSky field, a prime field, so its witness batch has no
///   randomizers and both of its base-field batches only differ from the others by the DSTs of
///   their Merkle leaves.
struct PlonkCircuit {
  /// @dev The Merkle root of the circuit batch (`CompressedCircuit::commitment`).
  bytes32 commitment;
  /// @dev The settings of the PCS fixed by the circuit: the degree bound, the security level, the
  ///   blowup factor, and the minimum number of grinding bits. The FRI settings are ignored,
  ///   because every proof chooses its own.
  DeepOptions pcsConfig;
  /// @dev The number of witness columns.
  uint256 numColumns;
  /// @dev The number of distinct gate selectors.
  uint256 numGateSelectors;
  /// @dev The number of chunks of the quotient.
  uint256 numQuotientChunks;
  /// @dev Whether the circuit is blinded, which adds the FRI randomizer to the quotient batch.
  bool blinded;
  /// @dev The rotations of the variables of the gate constraints plus 0 and 1, which are always
  ///   opened, sorted by strictly increasing value.
  int256[] rotations;
  /// @dev The public cells, sorted by row and then by column.
  PlonkCell[] publicCells;
}

/// @notice The data of a PLONK proof needed by the algebraic checks, which `PlonkVerifier.verify`
///   returns once it has verified the DEEP-FRI proof.
struct PlonkProof {
  /// @dev The values of the public cells, in the order of `PlonkCircuit.publicCells`.
  uint256[] publicInputs;
  /// @dev The DEEP-FRI commitment: the circuit, witness, permutation argument, and quotient
  ///   batches.
  DeepCommitment commitment;
  /// @dev The parameters of the DEEP-FRI proof.
  DeepOptions options;
  /// @dev The challenge `xi`, from which the opened points are derived.
  uint256 xi;
  /// @dev The evaluations of all the committed polynomials, in commitment order, at the opened
  ///   points: `evaluations[i]` holds those at `xi * omega^r` with `r = rotations[i]`, `omega`
  ///   being the generator of the evaluation domain.
  uint256[][] evaluations;
}

/// @title PlonkVerifier
/// @notice Reads PLONK proofs generated by `starkom-plonk` 11 with the Keccak-256 hash backend over
///   the BlueSky field, encoded by `Proof::to_scpf`, and verifies their DEEP-FRI proofs.
/// @dev WARNING: this library doesn't perform the algebraic checks of the PLONK verifier yet (the
///   gate constraints, the permutation argument, the public cells, and the recombination of the
///   quotient), so on its own it's not a sound PLONK verifier. The algebraic checks depend on the
///   gates of the circuit and will be performed by generated code, using the `PlonkProof` returned
///   by `verify`. In particular, the public inputs are only bound to the proof by those checks.
library PlonkVerifier {
  using BlueSky for uint256;
  using ProofViewerMethods for ProofViewer;

  /// @dev The layout identifier of the SCPF data of PLONK proofs: the Keccak-256 hash of the full
  ///   name of the `Proof` protobuf of `starkom-plonk` (see its `SCPF.md` file).
  bytes32 constant PROOF_LAYOUT_IDENTIFIER = keccak256("starkom.proto.plonk.v12.Proof");

  /// @dev Domain separator of the transcript hash of a DEEP-FRI commitment, the hash of its batch
  ///   count and Merkle roots: `SHA3-256("starkom/deep/transcript")`. Matches the `TRANSCRIPT_DST`
  ///   of `starkom-pcs`.
  bytes32 constant TRANSCRIPT_DST =
    0x09f36235476a658841de9bcdd34e1ac31ec792e41def5de31aecb4eb3bb1816b;

  /// @dev Domain separator of the challenge `xi`: `SHA3-256("starkom/plonk/challenge/xi")`.
  bytes32 constant XI_DST = 0x8019e1b162ea095e9f712d806342f526a87850fa1c86a722faf2156ee562e23e;

  /// @dev The indices of the batches of the commitment.
  uint256 constant COMMIT_INDEX_CIRCUIT = 0;
  uint256 constant COMMIT_INDEX_WITNESS = 1;
  uint256 constant COMMIT_INDEX_PERMUTATION_ARGUMENT = 2;
  uint256 constant COMMIT_INDEX_QUOTIENT = 3;
  uint256 constant NUM_BATCHES = 4;

  /// @notice Reads a PLONK proof of `circuit` and verifies its DEEP-FRI proof, reverting if it's
  ///   invalid, and returns the data needed by the algebraic checks.
  /// @dev Performs the checks of `CompressedCircuit::verify` that don't depend on the gates: the
  ///   commitment has the batches derived from the circuit and the root of the circuit batch is
  ///   the commitment of the circuit, the proof opens `xi * omega^r` for every rotation `r` of the
  ///   circuit, and the DEEP-FRI proof is valid and satisfies the PCS settings of the circuit.
  ///
  ///   `proof` is encoded in SCPF (see `ProofViewer`) by `Proof::to_scpf`, with the layout
  ///   identifier `PROOF_LAYOUT_IDENTIFIER`: the values of the public cells as inline words, the
  ///   roots of the witness, permutation argument, and quotient batches as pool references, and
  ///   the DEEP-FRI proof (see `DeepVerifier.verify`). Everything else, e.g. the opened points, is
  ///   derived from the circuit.
  function verify(
    PlonkCircuit memory circuit,
    bytes calldata proof
  ) internal view returns (PlonkProof memory result) {
    ProofViewer memory viewer = ProofViewerMethods.open(proof, PROOF_LAYOUT_IDENTIFIER);
    result.publicInputs = viewer.popWords(circuit.publicCells.length);
    for (uint256 i = 0; i < result.publicInputs.length; i++) {
      if (result.publicInputs[i] >= BlueSky.P) {
        revert Merkle.NonCanonicalScalar(result.publicInputs[i]);
      }
    }
    result.commitment = _readCommitment(viewer, circuit);
    result.xi = xi(result.commitment);
    (uint256[] memory zs, uint256[] memory order) = _points(circuit, result.xi);
    DeepPoint[] memory points;
    (result.options, points) = DeepVerifier.verify(
      viewer,
      circuit.pcsConfig,
      result.commitment,
      zs
    );
    viewer.close();
    result.evaluations = new uint256[][](points.length);
    for (uint256 j = 0; j < points.length; j++) {
      result.evaluations[order[j]] = points[j].values;
    }
  }

  /// @notice Returns the transcript hash of all the batches of a commitment, i.e. the hash of their
  ///   count and their Merkle roots. Matches `Commitment::transcript_hash` of `starkom-pcs`.
  function transcriptHash(DeepCommitment memory commitment) internal pure returns (bytes32) {
    DeepBatch[] memory batches = commitment.batches;
    bytes32[] memory transcript = new bytes32[](batches.length + 1);
    transcript[0] = bytes32(batches.length);
    for (uint256 b = 0; b < batches.length; b++) {
      transcript[b + 1] = batches[b].root;
    }
    return Keccak256Hash.hashTranscript(TRANSCRIPT_DST, transcript);
  }

  /// @notice Derives the challenge `xi` from the commitment, like `CompressedCircuit::verify`.
  function xi(DeepCommitment memory commitment) internal pure returns (uint256) {
    bytes32[] memory transcript = new bytes32[](1);
    transcript[0] = transcriptHash(commitment);
    return Keccak256Hash.challenge(XI_DST, transcript);
  }

  /// @dev Reads the roots of the witness, permutation argument, and quotient batches, and returns
  ///   the commitment with the shape derived from the circuit.
  function _readCommitment(
    ProofViewer memory viewer,
    PlonkCircuit memory circuit
  ) private pure returns (DeepCommitment memory commitment) {
    commitment.batches = new DeepBatch[](NUM_BATCHES);
    commitment.batches[COMMIT_INDEX_CIRCUIT] = DeepBatch({
      baseField: true,
      // The gate selectors, the sigma polynomials, and the circuit area selector.
      numPolys: circuit.numGateSelectors + circuit.numColumns + 1,
      root: circuit.commitment
    });
    commitment.batches[COMMIT_INDEX_WITNESS] = DeepBatch({
      baseField: true,
      numPolys: circuit.numColumns,
      root: viewer.popPoolWord()
    });
    commitment.batches[COMMIT_INDEX_PERMUTATION_ARGUMENT] = DeepBatch({
      baseField: false,
      // The accumulator and one helper for every column.
      numPolys: 1 + circuit.numColumns,
      root: viewer.popPoolWord()
    });
    commitment.batches[COMMIT_INDEX_QUOTIENT] = DeepBatch({
      baseField: false,
      // The chunks of the quotient and the FRI randomizer of blinded circuits.
      numPolys: circuit.numQuotientChunks + (circuit.blinded ? 1 : 0),
      root: viewer.popPoolWord()
    });
  }

  /// @dev Returns the opened points `xi * omega^r` for all the rotations `r` of the circuit,
  ///   sorted by increasing value, and for every sorted point the index of its rotation.
  function _points(
    PlonkCircuit memory circuit,
    uint256 challenge
  ) private view returns (uint256[] memory zs, uint256[] memory order) {
    // The generator of the evaluation domain, whose size is the degree bound, and its inverse.
    uint256 shift = 1 << (BlueSky.S - _log2(circuit.pcsConfig.degreeBound));
    uint256 omega = BlueSky.TWO_ADIC_ROOT_OF_UNITY.pow(shift);
    uint256 omegaInverse = BlueSky.TWO_ADIC_ROOT_OF_UNITY_INV.pow(shift);
    int256[] memory rotations = circuit.rotations;
    zs = new uint256[](rotations.length);
    order = new uint256[](rotations.length);
    // Insertion sort, because circuits only have a few rotations.
    for (uint256 i = 0; i < rotations.length; i++) {
      int256 rotation = rotations[i];
      uint256 z =
        rotation < 0
          ? challenge.mul(omegaInverse.pow(uint256(-rotation)))
          : challenge.mul(omega.pow(uint256(rotation)));
      uint256 j = i;
      while (j > 0 && zs[j - 1] > z) {
        zs[j] = zs[j - 1];
        order[j] = order[j - 1];
        j--;
      }
      zs[j] = z;
      order[j] = i;
    }
  }

  /// @dev Returns log2(n) for a power of 2 n.
  function _log2(uint256 n) private pure returns (uint256 result) {
    while (n > 1) {
      n >>= 1;
      result++;
    }
  }
}
