pragma solidity ^0.8.34;

import "@starkom/bluesky/contracts/BlueSky.sol";
import "./DEEP.sol";
import "./Keccak256Hash.sol";
import "./ProofViewer.sol";

/// @notice A cell of a circuit, identified by its row and its column.
struct PlonkCell {
  uint256 row;
  uint256 column;
}

/// @notice What the verifier needs to know about a circuit to read and verify its proofs, i.e. the
///   parts of a `CompressedCircuit` of `starkom-plonk` other than the gates.
/// @dev The circuit is over the BlueSky field, a prime field, so its witness batch has no
///   randomizers and both of its base-field batches only differ from the others by the DSTs of
///   their Merkle leaves.
struct PlonkCircuit {
  /// @dev The Merkle root of the circuit batch.
  bytes32 commitment;
  /// @dev The settings of the PCS fixed by the circuit: the degree bound, the security level, the
  ///   blowup factor, and the minimum number of grinding bits. The FRI settings are ignored,
  ///   because every proof chooses its own.
  DeepOptions pcsConfig;
  /// @dev The number of rows of the circuit area, without the blinding rows and the padding.
  uint256 numRows;
  /// @dev The number of witness columns.
  uint256 numColumns;
  /// @dev The number of distinct gate selectors.
  uint256 numGateSelectors;
  /// @dev The number of chunks of the PLONK quotient.
  uint256 numQuotientChunks;
  /// @dev Whether the circuit is blinded, which affects the minimum padding area size and adds the
  ///   FRI randomizer to the quotient batch.
  bool blinded;
  /// @dev The rotations used in the circuit, deduplicated and sorted in ascending order. Rotations
  ///   0 and +1 are always included because they correspond to the `xi` and `xi*omega` openings
  ///   required by the permutation argument.
  int256[] rotations;
  /// @dev The public cells, sorted by row and then by column.
  PlonkCell[] publicCells;
}

/// @notice The full set of Fiat-Shamir challenges used at the PLONK layer, derived like
///   `CompressedCircuit::verify` from the transcript hashes of various polynomial batches.
struct PlonkChallenges {
  /// @dev The beta challenge of the permutation argument, which follows the witness batch.
  uint256 beta;
  /// @dev The gamma challenge of the permutation argument, which follows the witness batch.
  uint256 gamma;
  /// @dev Combines the gate instances. It follows the witness batch.
  uint256 delta;
  /// @dev Combines all the constraints. It follows the permutation argument batch.
  uint256 alpha;
  /// @dev Combines the public cells. It follows the permutation argument batch and the public cells
  ///   with their values. The latter aren't bound by any Merkle roots but they must be included in
  ///   the psi challenge.
  uint256 psi;
  /// @dev The main opened point, which follows the quotient batch.
  uint256 xi;
}

/// @notice The data of a PLONK proof needed by the algebraic checks, which `PlonkVerifier.verify`
///   returns once it has verified the DEEP-FRI proof.
struct PlonkProof {
  /// @dev The values of the public cells, in the order of `PlonkCircuit.publicCells`.
  uint256[] publicInputs;
  /// @dev The parameters of the DEEP-FRI proof, chosen by the prover.
  DeepOptions options;
  /// @dev The full set of Fiat-Shamir challenges used at the PLONK layer.
  PlonkChallenges challenges;
  /// @dev The evaluations of all the committed polynomials, in commitment order, at the opened
  ///   points: `evaluations[i]` holds those at `xi * omega^r` with `r = rotations[i]`, `omega`
  ///   being the generator of the evaluation domain.
  uint256[][] evaluations;
}

/// @title PlonkVerifier
/// @notice Reads PLONK proofs generated by `starkom-plonk` with the Keccak-256 hash backend over
///   the BlueSky field, and performs all the checks of their verifier that don't depend on the
///   gates of the circuit.
/// @dev Verifying a proof takes two steps, with the gate constraint in between: `verify` reads the
///   proof, verifies the nested DEEP-FRI proof, and derives its challenges; and `checkConstraints`
///   performs the algebraic checks. The gate constraint depends on the gates of the circuit, so
///   generated code evaluates it in between (see `CompressedCircuit::emit_gate_libraries` of
///   `starkom-plonk`).
///
///   WARNING: `verify` alone isn't a sound PLONK verifier. In particular, the public inputs are
///   only bound to the proof by `checkConstraints`.
library PlonkVerifier {
  using BlueSky for uint256;
  using ProofViewerMethods for ProofViewer;

  /// @dev Reverted when the evaluations of a proof don't satisfy the constraints of the circuit,
  ///   e.g. because its public inputs aren't the ones it was generated with.
  error ConstraintViolation();

  /// @dev Reverted when the rotations of a circuit don't include `rotation`, which must be opened.
  error MissingRotation(int256 rotation);

  /// @dev The evaluations read by the algebraic checks: those at xi and at xi * omega, and the
  ///   offsets of the committed polynomials in the evaluations at every point, which follow the
  ///   commitment order: the circuit batch (the gate selectors, first, then the sigmas, and the
  ///   circuit area selector), the witness batch (the columns, with no randomizers because BlueSky
  ///   is a prime field), the permutation argument batch (the accumulator and one helper per
  ///   column), and the quotient batch (the chunks, then the FRI randomizer of blinded circuits,
  ///   which no check uses).
  struct Evaluations {
    uint256[] atXi;
    uint256[] atXiOmega;
    uint256 sigmas;
    uint256 circuitAreaSelector;
    uint256 witness;
    uint256 accumulator;
    uint256 helpers;
    uint256 quotient;
  }

  /// @dev The layout identifier of the SCPF data of PLONK proofs: the Keccak-256 hash of the full
  ///   name of the `Proof` protobuf of `starkom-plonk` (see its `SCPF.md` file).
  bytes32 constant PROOF_LAYOUT_IDENTIFIER = keccak256("starkom.proto.plonk.v12.Proof");

  /// @dev Domain separator of the transcript hash of a DEEP-FRI commitment, the hash of its batch
  ///   count and Merkle roots: `SHA3-256("starkom/deep/transcript")`. Matches the `TRANSCRIPT_DST`
  ///   of `starkom-pcs`.
  bytes32 constant TRANSCRIPT_DST =
    0x09f36235476a658841de9bcdd34e1ac31ec792e41def5de31aecb4eb3bb1816b;

  /// @dev Domain separators of the challenges: `SHA3-256("starkom/plonk/challenge/<name>")`. Match
  ///   the `DST_*` constants of `starkom-plonk`.
  bytes32 constant BETA_DST = 0x6ac01a59446d803f8359ede12701eb55e503f596ba441300eb931bd81ad058d6;
  bytes32 constant GAMMA_DST = 0xabd118d5a168f7fa466d8eb4ee40b2ba7db9c34da1d4507ceddfe3f872851ab1;
  bytes32 constant DELTA_DST = 0x272e0bb75b662069989ed5ce44a39223d708b0ee3b6e76c1e8daeb559ca32e92;
  bytes32 constant ALPHA_DST = 0x71f5495ba568c2a3fbf17efdb9c8c8cfd404b7b7fa5e9a08a6092ef70466fd18;
  bytes32 constant PSI_DST = 0x8d22de61407f4ca720d195614f86eda2dcb9b082181bd1cd282f0591ba060d66;
  bytes32 constant XI_DST = 0x8019e1b162ea095e9f712d806342f526a87850fa1c86a722faf2156ee562e23e;

  /// @dev The indices of the batches of the commitment.
  uint256 constant COMMIT_INDEX_CIRCUIT = 0;
  uint256 constant COMMIT_INDEX_WITNESS = 1;
  uint256 constant COMMIT_INDEX_PERMUTATION_ARGUMENT = 2;
  uint256 constant COMMIT_INDEX_QUOTIENT = 3;
  uint256 constant NUM_BATCHES = 4;

  /// @notice Reads a PLONK proof of `circuit` and verifies its DEEP-FRI proof, reverting if it's
  ///   invalid, and returns the data needed by the algebraic checks, including all the challenges.
  /// @dev Performs the checks of `CompressedCircuit::verify` that don't depend on the gates: the
  ///   commitment has the batches derived from the circuit and the root of the circuit batch is
  ///   the commitment of the circuit, the proof opens `xi * omega^r` for every rotation `r` of the
  ///   circuit, and the DEEP-FRI proof is valid and satisfies the PCS settings of the circuit.
  ///
  ///   `proof` is encoded in SCPF (see `ProofViewer`) by `Proof::to_scpf`, with the layout
  ///   identifier `PROOF_LAYOUT_IDENTIFIER`: the values of the public cells as inline words, the
  ///   roots of the witness, permutation argument, and quotient batches as pool references, and
  ///   the DEEP-FRI proof (see `DeepVerifier.verify`). Everything else, e.g. the opened points, is
  ///   derived from the circuit.
  function verify(
    PlonkCircuit memory circuit,
    bytes calldata proof
  ) internal view returns (PlonkProof memory result) {
    ProofViewer memory viewer = ProofViewerMethods.open(proof, PROOF_LAYOUT_IDENTIFIER);
    result.publicInputs = viewer.popWords(circuit.publicCells.length);
    for (uint256 i = 0; i < result.publicInputs.length; i++) {
      if (result.publicInputs[i] >= BlueSky.P) {
        revert Merkle.NonCanonicalScalar(result.publicInputs[i]);
      }
    }
    DeepCommitment memory commitment = _readCommitment(viewer, circuit);
    result.challenges = _challenges(commitment, circuit.publicCells, result.publicInputs);
    (uint256[] memory zs, uint256[] memory order) = _points(circuit, result.challenges.xi);
    DeepPoint[] memory points;
    (result.options, points) = DeepVerifier.verify(viewer, circuit.pcsConfig, commitment, zs);
    viewer.close();
    result.evaluations = new uint256[][](points.length);
    for (uint256 j = 0; j < points.length; j++) {
      result.evaluations[order[j]] = points[j].values;
    }
  }

  /// @notice Performs the algebraic checks of `CompressedCircuit::verify` on a proof returned by
  ///   `verify`, given its gate constraint, and reverts if they fail.
  /// @dev `gateConstraint` is the sum, over the gate instances k in the order of the compressed
  ///   circuit, of selector_k(xi) * delta^k * C_k(xi), C_k being the constraint of instance k. It's
  ///   combined with the anchors of the permutation argument at alpha and alpha^2, the helper
  ///   constraints at the next powers of alpha, then the recurrence, then the public cells, and the
  ///   combination must be the quotient times the zero polynomial x^N - 1.
  function checkConstraints(
    PlonkCircuit memory circuit,
    PlonkProof memory proof,
    uint256 gateConstraint
  ) internal view {
    Evaluations memory evaluations = _evaluations(circuit, proof);
    uint256 xi = proof.challenges.xi;
    uint256 zero = xi.pow(circuit.pcsConfig.degreeBound).sub(1);
    uint256 result = gateConstraint.add(_otherConstraints(circuit, proof, evaluations, zero));
    if (result != _quotient(circuit, evaluations, xi).mul(zero)) {
      revert ConstraintViolation();
    }
  }

  /// @dev Derives the challenges like `CompressedCircuit::verify`.
  function _challenges(
    DeepCommitment memory commitment,
    PlonkCell[] memory publicCells,
    uint256[] memory publicInputs
  ) private pure returns (PlonkChallenges memory challenges) {
    bytes32[] memory transcript = new bytes32[](1);
    transcript[0] = _transcriptHash(commitment, COMMIT_INDEX_WITNESS + 1);
    challenges.beta = Keccak256Hash.challenge(BETA_DST, transcript);
    challenges.gamma = Keccak256Hash.challenge(GAMMA_DST, transcript);
    challenges.delta = Keccak256Hash.challenge(DELTA_DST, transcript);
    bytes32 transcriptHash = _transcriptHash(commitment, COMMIT_INDEX_PERMUTATION_ARGUMENT + 1);
    transcript[0] = transcriptHash;
    challenges.alpha = Keccak256Hash.challenge(ALPHA_DST, transcript);
    challenges.psi = _publicCellChallenge(transcriptHash, publicCells, publicInputs);
    transcript[0] = _transcriptHash(commitment, NUM_BATCHES);
    challenges.xi = Keccak256Hash.challenge(XI_DST, transcript);
  }

  /// @dev Returns the transcript hash of the first `numBatches` batches of a commitment, i.e. the
  ///   hash of their count and their Merkle roots. Matches `Commitment::transcript_hash` of
  ///   `starkom-pcs`.
  function _transcriptHash(
    DeepCommitment memory commitment,
    uint256 numBatches
  ) private pure returns (bytes32) {
    bytes32[] memory transcript = new bytes32[](numBatches + 1);
    transcript[0] = bytes32(numBatches);
    for (uint256 b = 0; b < numBatches; b++) {
      transcript[b + 1] = commitment.batches[b].root;
    }
    return Keccak256Hash.hashTranscript(TRANSCRIPT_DST, transcript);
  }

  /// @dev Derives the challenge psi like `public_cell_challenge` of `starkom-plonk`: its transcript
  ///   is `transcriptHash`, the number of public cells, and every public cell followed by its
  ///   value, the cell encoded as `row << 128 | column` (see `encode_cell`).
  function _publicCellChallenge(
    bytes32 transcriptHash,
    PlonkCell[] memory publicCells,
    uint256[] memory publicInputs
  ) private pure returns (uint256) {
    uint256 numPublicCells = publicCells.length;
    bytes32[] memory transcript = new bytes32[](2 + 2 * numPublicCells);
    transcript[0] = transcriptHash;
    transcript[1] = bytes32(numPublicCells);
    for (uint256 i = 0; i < numPublicCells; i++) {
      PlonkCell memory cell = publicCells[i];
      transcript[2 + 2 * i] = bytes32((cell.row << 128) | cell.column);
      transcript[3 + 2 * i] = bytes32(publicInputs[i]);
    }
    return Keccak256Hash.challenge(PSI_DST, transcript);
  }

  /// @dev Reads the roots of the witness, permutation argument, and quotient batches, and returns
  ///   the commitment with the shape derived from the circuit.
  function _readCommitment(
    ProofViewer memory viewer,
    PlonkCircuit memory circuit
  ) private pure returns (DeepCommitment memory commitment) {
    commitment.batches = new DeepBatch[](NUM_BATCHES);
    commitment.batches[COMMIT_INDEX_CIRCUIT] = DeepBatch({
      baseField: true,
      // The gate selectors, the sigma polynomials, and the circuit area selector.
      numPolys: circuit.numGateSelectors + circuit.numColumns + 1,
      root: circuit.commitment
    });
    commitment.batches[COMMIT_INDEX_WITNESS] = DeepBatch({
      baseField: true,
      numPolys: circuit.numColumns,
      root: viewer.popPoolWord()
    });
    commitment.batches[COMMIT_INDEX_PERMUTATION_ARGUMENT] = DeepBatch({
      baseField: false,
      // The accumulator and one helper for every column.
      numPolys: 1 + circuit.numColumns,
      root: viewer.popPoolWord()
    });
    commitment.batches[COMMIT_INDEX_QUOTIENT] = DeepBatch({
      baseField: false,
      // The chunks of the quotient and the FRI randomizer of blinded circuits.
      numPolys: circuit.numQuotientChunks + (circuit.blinded ? 1 : 0),
      root: viewer.popPoolWord()
    });
  }

  /// @dev Returns the opened points `xi * omega^r` for all the rotations `r` of the circuit,
  ///   sorted by increasing value, and for every sorted point the index of its rotation.
  function _points(
    PlonkCircuit memory circuit,
    uint256 challenge
  ) private view returns (uint256[] memory zs, uint256[] memory order) {
    (uint256 omega, uint256 omegaInverse) = _omega(circuit.pcsConfig.degreeBound);
    int256[] memory rotations = circuit.rotations;
    zs = new uint256[](rotations.length);
    order = new uint256[](rotations.length);
    // Insertion sort, because circuits only have a few rotations.
    for (uint256 i = 0; i < rotations.length; i++) {
      int256 rotation = rotations[i];
      uint256 z = rotation < 0
        ? challenge.mul(omegaInverse.pow(uint256(-rotation)))
        : challenge.mul(omega.pow(uint256(rotation)));
      uint256 j = i;
      while (j > 0 && zs[j - 1] > z) {
        zs[j] = zs[j - 1];
        order[j] = order[j - 1];
        j--;
      }
      zs[j] = z;
      order[j] = i;
    }
  }

  /// @dev Returns omega, the generator of the evaluation domain, whose size is `degreeBound`, and
  ///   its inverse.
  function _omega(uint256 degreeBound) private view returns (uint256 omega, uint256 omegaInverse) {
    uint256 shift = 1 << (BlueSky.S - _log2(degreeBound));
    omega = BlueSky.TWO_ADIC_ROOT_OF_UNITY.pow(shift);
    omegaInverse = BlueSky.TWO_ADIC_ROOT_OF_UNITY_INV.pow(shift);
  }

  /// @dev Returns the index of `rotation` in the rotations of the circuit, i.e. of the evaluations
  ///   at `xi * omega^rotation` in `PlonkProof.evaluations`.
  function _rotationIndex(
    PlonkCircuit memory circuit,
    int256 rotation
  ) private pure returns (uint256) {
    int256[] memory rotations = circuit.rotations;
    for (uint256 i = 0; i < rotations.length; i++) {
      if (rotations[i] == rotation) {
        return i;
      }
    }
    revert MissingRotation(rotation);
  }

  /// @dev Returns the evaluations of `proof` read by the algebraic checks (see `Evaluations`).
  function _evaluations(
    PlonkCircuit memory circuit,
    PlonkProof memory proof
  ) private pure returns (Evaluations memory evaluations) {
    evaluations.atXi = proof.evaluations[_rotationIndex(circuit, 0)];
    evaluations.atXiOmega = proof.evaluations[_rotationIndex(circuit, 1)];
    evaluations.sigmas = circuit.numGateSelectors;
    evaluations.circuitAreaSelector = evaluations.sigmas + circuit.numColumns;
    evaluations.witness = evaluations.circuitAreaSelector + 1;
    evaluations.accumulator = evaluations.witness + circuit.numColumns;
    evaluations.helpers = evaluations.accumulator + 1;
    evaluations.quotient = evaluations.helpers + circuit.numColumns;
  }

  /// @dev Returns the combination of all the constraints but the gate constraint: the anchors of
  ///   the permutation argument weighed by alpha and alpha^2, the helper constraints by the next
  ///   powers of alpha, then the recurrence, then the public cells.
  function _otherConstraints(
    PlonkCircuit memory circuit,
    PlonkProof memory proof,
    Evaluations memory evaluations,
    uint256 zero
  ) private view returns (uint256 result) {
    uint256 alpha = proof.challenges.alpha;
    uint256[] memory lagrange = _lagrangeEvaluations(circuit, proof.challenges.xi, zero);
    // The accumulator of the permutation argument starts and ends at zero.
    uint256 accumulator = evaluations.atXi[evaluations.accumulator];
    result = alpha.mul(accumulator).mul(lagrange[0]);
    uint256 power = alpha.mul(alpha);
    result = result.add(power.mul(accumulator).mul(lagrange[1]));
    power = power.mul(alpha);
    uint256 permutation;
    (permutation, power) = _permutationConstraints(circuit, evaluations, proof.challenges, power);
    result = result.add(permutation);
    result = result.add(power.mul(_publicCellConstraint(circuit, evaluations, proof, lagrange)));
  }

  /// @dev Returns the evaluations at xi of the Lagrange polynomials L_r(x) = (x^N - 1) * omega^r /
  ///   (N * (x - omega^r)) of the first row, of the first row past the circuit area (row
  ///   `numRows`), and of the row of every public cell, in the order of the public cells, computed
  ///   with one inversion. `zero` is xi^N - 1.
  function _lagrangeEvaluations(
    PlonkCircuit memory circuit,
    uint256 xi,
    uint256 zero
  ) private view returns (uint256[] memory lagrange) {
    uint256 degreeBound = circuit.pcsConfig.degreeBound;
    (uint256 omega, uint256 omegaInverse) = _omega(degreeBound);
    PlonkCell[] memory publicCells = circuit.publicCells;
    uint256[] memory omegaPowers = new uint256[](publicCells.length);
    lagrange = new uint256[](2 + publicCells.length);
    lagrange[0] = xi.sub(1).mul(degreeBound);
    // L_0(xi * omega^(-numRows)), like `CompressedCircuit::verify`, which is the same.
    lagrange[1] = xi.mul(omegaInverse.pow(circuit.numRows)).sub(1).mul(degreeBound);
    for (uint256 i = 0; i < publicCells.length; i++) {
      omegaPowers[i] = omega.pow(publicCells[i].row);
      lagrange[2 + i] = xi.sub(omegaPowers[i]).mul(degreeBound);
    }
    BlueSky.invBatch(lagrange);
    lagrange[0] = lagrange[0].mul(zero);
    lagrange[1] = lagrange[1].mul(zero);
    for (uint256 i = 0; i < publicCells.length; i++) {
      lagrange[2 + i] = lagrange[2 + i].mul(zero).mul(omegaPowers[i]);
    }
  }

  /// @dev Returns the constraints of the permutation argument, a LogUp argument with one helper per
  ///   column, weighed by consecutive powers of alpha starting with `power`, and the next power of
  ///   alpha.
  ///
  ///   The helper of column i is h_i = 1 / (w_i + beta * id_i + gamma) - 1 / (w_i + beta * sigma_i
  ///   + gamma), where id_i(x) = g^i * x, g being the multiplicative generator, which the helper
  ///   constraint checks without divisions. The accumulator Z adds up the helpers row by row, so
  ///   Z(x * omega) - Z(x) = sum of h_i(x). Both constraints only apply to the circuit area, so
  ///   their sum gets multiplied by the circuit area selector once.
  function _permutationConstraints(
    PlonkCircuit memory circuit,
    Evaluations memory evaluations,
    PlonkChallenges memory challenges,
    uint256 power
  ) private pure returns (uint256 constraints, uint256 nextPower) {
    uint256 identity = challenges.xi;
    uint256 sumOfHelpers = 0;
    for (uint256 i = 0; i < circuit.numColumns; i++) {
      uint256 constraint = _helperConstraint(evaluations, i, identity, challenges);
      constraints = constraints.add(power.mul(constraint));
      power = power.mul(challenges.alpha);
      sumOfHelpers = sumOfHelpers.add(evaluations.atXi[evaluations.helpers + i]);
      identity = identity.mul(BlueSky.MULTIPLICATIVE_GENERATOR);
    }
    uint256 accumulator = evaluations.atXi[evaluations.accumulator];
    uint256 recurrence = evaluations.atXiOmega[evaluations.accumulator].sub(accumulator).sub(
      sumOfHelpers
    );
    uint256 circuitAreaSelector = evaluations.atXi[evaluations.circuitAreaSelector];
    constraints = constraints.add(power.mul(recurrence)).mul(circuitAreaSelector);
    nextPower = power.mul(challenges.alpha);
  }

  /// @dev Returns the helper constraint of `column`, h * (w + beta * id + gamma) * (w + beta *
  ///   sigma + gamma) + beta * (id - sigma), which is zero iff h = 1 / (w + beta * id + gamma) - 1 /
  ///   (w + beta * sigma + gamma). `identity` is id(xi) of the column.
  function _helperConstraint(
    Evaluations memory evaluations,
    uint256 column,
    uint256 identity,
    PlonkChallenges memory challenges
  ) private pure returns (uint256) {
    uint256[] memory atXi = evaluations.atXi;
    uint256 witness = atXi[evaluations.witness + column];
    uint256 sigma = atXi[evaluations.sigmas + column];
    uint256 identityFactor = witness.add(challenges.beta.mul(identity)).add(challenges.gamma);
    uint256 sigmaFactor = witness.add(challenges.beta.mul(sigma)).add(challenges.gamma);
    uint256 helper = atXi[evaluations.helpers + column];
    return
      helper.mul(identityFactor).mul(sigmaFactor).add(challenges.beta.mul(identity.sub(sigma)));
  }

  /// @dev Returns the constraint of the public cells: the sum over the public cells of psi^column *
  ///   L_row(xi) * (w_column(xi) - value), `lagrange` being the result of `_lagrangeEvaluations`.
  function _publicCellConstraint(
    PlonkCircuit memory circuit,
    Evaluations memory evaluations,
    PlonkProof memory proof,
    uint256[] memory lagrange
  ) private view returns (uint256 result) {
    PlonkCell[] memory publicCells = circuit.publicCells;
    for (uint256 i = 0; i < publicCells.length; i++) {
      PlonkCell memory cell = publicCells[i];
      uint256 value = evaluations.atXi[evaluations.witness + cell.column];
      uint256 difference = value.sub(proof.publicInputs[i]);
      result = result.add(
        proof.challenges.psi.pow(cell.column).mul(lagrange[2 + i]).mul(difference)
      );
    }
  }

  /// @dev Returns the evaluation of the quotient at xi, the sum of the evaluations of its chunks
  ///   times powers of xi^stride (see `_quotientStride`).
  function _quotient(
    PlonkCircuit memory circuit,
    Evaluations memory evaluations,
    uint256 xi
  ) private view returns (uint256 result) {
    uint256 stridePower = xi.pow(_quotientStride(circuit));
    uint256 power = 1;
    for (uint256 i = 0; i < circuit.numQuotientChunks; i++) {
      result = result.add(evaluations.atXi[evaluations.quotient + i].mul(power));
      power = power.mul(stridePower);
    }
  }

  /// @dev Returns the stride of the split of the quotient into chunks, like
  ///   `CompressedCircuit::get_quotient_stride`: the degree bound minus, in blinded circuits, the
  ///   degree bound of the masks of the chunks, which compensate for the opened points and the
  ///   largest number of queries.
  function _quotientStride(PlonkCircuit memory circuit) private pure returns (uint256) {
    DeepOptions memory config = circuit.pcsConfig;
    if (!circuit.blinded) {
      return config.degreeBound;
    }
    uint256 numQueries = DeepVerifier.numQueries(
      config.securityBits,
      config.blowupLog2,
      config.grindingBits
    );
    return config.degreeBound - (circuit.rotations.length + numQueries + 1);
  }

  /// @dev Returns log2(n) for a power of 2 n.
  function _log2(uint256 n) private pure returns (uint256 result) {
    while (n > 1) {
      n >>= 1;
      result++;
    }
  }
}
