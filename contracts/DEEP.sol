pragma solidity ^0.8.28;

import "./BlueSky.sol";
import "./FRI.sol";
import "./Keccak256Hash.sol";
import "./Merkle.sol";
import "./ProofViewer.sol";

/// @notice The parameters of the DEEP-FRI protocol.
/// @dev Matches `starkom_pcs::Options`, that is the `degree_bound`, `blowup_log2`, `fold_rate`,
///   `max_rounds`, and `grinding_bits` fields of the `Proof` protobuf.
struct DeepOptions {
    /// @dev The proven degree bound, a power of 2.
    uint256 degreeBound;
    /// @dev The base-2 logarithm of the blowup factor, greater than 0.
    uint256 blowupLog2;
    /// @dev The number of FRI folds per round, greater than 0.
    uint256 foldRate;
    /// @dev The maximum number of FRI folding rounds.
    uint256 maxRounds;
    /// @dev The number of grinding bits, at most 256 (the number of bits of the proof-of-work
    ///   hash).
    uint256 grindingBits;
}

/// @notice A batch of polynomials committed in the same Merkle tree.
/// @dev Matches the `Commitment.Batch` protobuf.
struct DeepBatch {
    /// @dev The root hash of the Merkle tree.
    bytes32 root;
    /// @dev The number of polynomials in the batch, which is the number of values in every leaf.
    uint256 numPolys;
}

/// @notice A batched DEEP-FRI polynomial commitment.
/// @dev Matches `starkom_pcs::Commitment` and the `Commitment` protobuf, without the hash backend
///   tag (this verifier only supports Keccak-256).
struct DeepCommitment {
    /// @dev The polynomial batches, in commitment order. There must be at least one.
    DeepBatch[] batches;
}

/// @notice A point opened by a DEEP-FRI proof.
/// @dev Matches the `Proof.Point` protobuf.
struct DeepPoint {
    /// @dev The (off-domain) X-coordinate, in [0, P).
    uint256 z;
    /// @dev The evaluations of every committed polynomial at `z`, in commitment order, each in
    ///   [0, P).
    uint256[] values;
}

/// @title DeepVerifier
/// @notice Verifies DEEP-FRI proofs generated by `starkom-pcs` 9 with the Keccak-256 hash backend
///   over the BlueSky field, encoded in the calldata format of the `calldata` crate (see
///   `ProofViewer`).
library DeepVerifier {
    using BlueSky for uint256;
    using ProofViewerMethods for ProofViewer;

    /// @dev Reverted when the commitment has no polynomial batches.
    error NoBatches();

    /// @dev Reverted when the number of grinding bits exceeds the number of bits of the
    ///   proof-of-work hash, because no hash can satisfy it.
    error InvalidGrindingBits(uint256 grindingBits);

    /// @dev Reverted when the number of polynomials of the proof differs from the commitment's.
    error InvalidNumberOfPolynomials(uint256 got, uint256 want);

    /// @dev Reverted when the proof doesn't open any points.
    error NoPoints();

    /// @dev Reverted when the opened points are not sorted by strictly increasing X-coordinate.
    error UnsortedPoints();

    /// @dev Reverted when an opened point lies in the evaluation domain.
    error PointInDomain(uint256 z);

    /// @dev Reverted when the proof-of-work hash doesn't have enough leading zero bits.
    error InsufficientProofOfWork();

    /// @dev Target security level in bits. Matches `deep::LAMBDA`.
    uint256 constant LAMBDA = 128;

    /// @dev The number of bits of a proof-of-work hash, which is the maximum number of grinding
    ///   bits. Matches `deep::PROOF_OF_WORK_BITS`.
    uint256 constant PROOF_OF_WORK_BITS = 256;

    /// @dev Domain separator of the query seed: `SHA3-256("starkom/deep/query/0")`.
    bytes32 constant QUERY_DST0 =
        0xbbec7289b9fc3aade75412c031b62a769b205d1d73b29c9a06dbb91943e046bc;

    /// @dev Domain separator of the query indices: `SHA3-256("starkom/deep/query/1")`.
    bytes32 constant QUERY_DST1 =
        0x88209086b178c9f2fb9c2f813cd229e1a2528cb4f5e6cd618710dc9869f14ac5;

    /// @dev Domain separator of the challenge combining the committed polynomials:
    ///   `SHA3-256("starkom/deep/rlc")`.
    bytes32 constant RLC_DST =
        0x688ae37e5f05871810e7c6777e1c16c55ef4b14f072357586d7a298cefc11368;

    /// @dev Domain separator of the challenge combining the DEEP quotients of the opened points:
    ///   `SHA3-256("starkom/deep/quotient")`.
    bytes32 constant QUOTIENT_DST =
        0xa7f91ddaa061a34288a9146bf5afc157211da6ec200650dd93daa9cb4c5b4808;

    /// @dev Domain separator of the proof of work: `SHA3-256("starkom/deep/pow")`.
    bytes32 constant POW_DST =
        0xd659450ee50ebd3de60604eff7a514c5873b63b66073b1164b1cb61b7b113a51;

    /// @dev Values shared by the checks of all the queries of a proof.
    struct Context {
        /// @dev The base-2 logarithm of the size of the extended evaluation domain.
        uint256 domainSizeLog2;
        /// @dev The challenge combining the committed polynomials.
        uint256 alpha;
        /// @dev The challenge combining the DEEP quotients of the opened points.
        uint256 beta;
        /// @dev The random linear combination with `alpha` of the evaluations at every point.
        uint256[] pointValues;
        /// @dev The query indices derived from the proof of work.
        uint256[] indices;
        /// @dev The inverses of `x_i - z_j`, with `x_i` being the element queried by query i and
        ///   `z_j` the j-th opened point, at position `i * points.length + j`.
        uint256[] inverses;
        /// @dev The FRI parameters.
        FriOptions friOptions;
        /// @dev The FRI commitment to the combined DEEP quotient.
        FriCommitment friCommitment;
    }

    /// @notice Returns the number of FRI queries required to achieve the target security level.
    /// @dev Matches `deep::num_queries`: every query provides `blowupLog2` bits of security and
    ///   grinding provides the rest. At least one query is always required.
    function numQueries(
        uint256 blowupLog2,
        uint256 grindingBits
    ) internal pure returns (uint256) {
        uint256 bits = grindingBits < LAMBDA ? LAMBDA - grindingBits : 0;
        uint256 queries = (bits + blowupLog2 - 1) / blowupLog2;
        return queries > 0 ? queries : 1;
    }

    /// @notice Encodes the transcript of the DEEP layer: all Merkle roots of the committed
    ///   polynomials, all opened points, and their evaluations.
    /// @dev Matches `deep::deep_transcript`.
    function deepTranscript(
        DeepCommitment memory commitment,
        uint256 numPolys,
        DeepPoint[] memory points
    ) internal pure returns (bytes32[] memory transcript) {
        DeepBatch[] memory batches = commitment.batches;
        uint256 length = batches.length + 3;
        for (uint256 j = 0; j < points.length; j++) {
            length += 1 + points[j].values.length;
        }
        transcript = new bytes32[](length);
        transcript[0] = bytes32(batches.length);
        uint256 position = 1;
        for (uint256 b = 0; b < batches.length; b++) {
            transcript[position++] = batches[b].root;
        }
        transcript[position++] = bytes32(numPolys);
        transcript[position++] = bytes32(points.length);
        for (uint256 j = 0; j < points.length; j++) {
            transcript[position++] = bytes32(points[j].z);
            uint256[] memory values = points[j].values;
            for (uint256 i = 0; i < values.length; i++) {
                transcript[position++] = bytes32(values[i]);
            }
        }
    }

    /// @notice Derives the challenges combining the committed polynomials and the DEEP quotients
    ///   of the opened points.
    /// @dev Matches `deep::deep_challenges`.
    function deepChallenges(
        bytes32[] memory transcript
    ) internal pure returns (uint256 alpha, uint256 beta) {
        alpha = Keccak256Hash.challenge(RLC_DST, transcript);
        beta = Keccak256Hash.challenge(QUOTIENT_DST, transcript);
    }

    /// @notice Hashes the full transcript of a proof up to the queries.
    /// @dev Matches `deep::query_seed`: it's the `Keccak256Hash.hashTranscript` of the DEEP
    ///   transcript followed by the number of FRI roots, the FRI roots, the number of coefficients
    ///   of the folded quotient, and the coefficients, but it hashes the two parts in place rather
    ///   than copying them into a single array.
    function querySeed(
        bytes32[] memory transcript,
        FriCommitment memory friCommitment
    ) internal pure returns (bytes32) {
        bytes32[] memory roots = friCommitment.roots;
        uint256[] memory coefficients = friCommitment.foldedPolynomial;
        uint256 length = transcript.length +
            2 +
            roots.length +
            coefficients.length;
        return
            keccak256(
                abi.encodePacked(
                    QUERY_DST0,
                    uint128(length),
                    transcript,
                    roots.length,
                    roots,
                    coefficients.length,
                    coefficients
                )
            );
    }

    /// @notice Computes the proof-of-work hash of a nonce. Matches `deep::proof_of_work`.
    function proofOfWork(
        bytes32 seed,
        uint64 nonce
    ) internal pure returns (bytes32) {
        bytes32[] memory transcript = new bytes32[](2);
        transcript[0] = seed;
        transcript[1] = bytes32(uint256(nonce));
        return Keccak256Hash.hashTranscript(POW_DST, transcript);
    }

    /// @notice Checks that a proof-of-work hash, interpreted as a big-endian integer, has at least
    ///   `grindingBits` leading zero bits. Matches `deep::check_proof_of_work`.
    function checkProofOfWork(
        bytes32 pow,
        uint256 grindingBits
    ) internal pure returns (bool) {
        if (grindingBits == 0) {
            return true;
        }
        if (grindingBits > 256) {
            return false;
        }
        return uint256(pow) >> (256 - grindingBits) == 0;
    }

    /// @notice Derives the index of the i-th FRI query from the proof-of-work hash.
    /// @dev Matches `deep::get_query_indices`.
    function queryIndex(
        bytes32 pow,
        uint256 i,
        uint256 domainSize
    ) internal pure returns (uint256) {
        bytes32[] memory transcript = new bytes32[](2);
        transcript[0] = pow;
        transcript[1] = bytes32(i);
        return Keccak256Hash.challenge(QUERY_DST1, transcript) % domainSize;
    }

    /// @notice Verifies a DEEP-FRI proof against a commitment, reverting if it's invalid, and
    ///   returns the parameters of the proof and its opened points.
    /// @dev Performs the checks of `Commitment::from_proto`, `Proof::from_proto`, and
    ///   `Proof::verify`. If verification succeeds, the committed polynomials have degree at most
    ///   `degreeBound` and their evaluations at the opened points are the ones claimed by the
    ///   proof (see `Proof::verify` for the degree slack).
    ///
    ///   Callers must check the returned parameters against the expected ones (see
    ///   `Options::satisfies`) and the returned points against the expected points.
    ///
    ///   `proof` is encoded in the calldata format of the `calldata` crate (see `ProofViewer`). Its
    ///   heap contains, in order: the parameters (`degreeBound`, `blowupLog2`, `foldRate`,
    ///   `maxRounds`, and `grindingBits`), the proof-of-work nonce, and the number of committed
    ///   polynomials as varints; the number of opened points as a varint, then for every point
    ///   its X-coordinate and its evaluations as inline words; the FRI roots as pool words; the
    ///   number of coefficients of the folded quotient as a varint and the coefficients as inline
    ///   words; and finally for every query, the openings of all the batches (for every batch, the
    ///   leaf values as inline words and the Merkle path from the leaf up as pool words) followed
    ///   by the openings of all the FRI rounds (see `FriVerifier.verifyQuery`). The numbers of
    ///   rounds and queries, the size of every leaf, the height of every Merkle path, and the
    ///   query indices are not encoded, because the verifier derives them.
    ///
    ///   Unlike the Rust implementation, which computes them for every query, this function
    ///   combines the evaluations at every point only once, and inverts all the denominators of the
    ///   DEEP quotients of all queries with a single batch inversion.
    function verify(
        DeepCommitment memory commitment,
        bytes calldata proof
    )
        internal
        view
        returns (DeepOptions memory options, DeepPoint[] memory points)
    {
        ProofViewer memory viewer = ProofViewerMethods.open(proof);
        options = _readOptions(viewer);
        Context memory context;
        context.domainSizeLog2 = _validateOptions(options);
        // The varint has at most 64 bits.
        uint64 nonce = uint64(viewer.popVarint());
        uint256 numPolys = viewer.popVarint();
        _validateBatches(commitment, numPolys);
        points = _readPoints(viewer, numPolys, context.domainSizeLog2);
        context.friOptions = FriOptions({
            degreeBound: options.degreeBound,
            blowupLog2: options.blowupLog2,
            foldRate: options.foldRate,
            maxRounds: options.maxRounds
        });
        context.friCommitment = _readFriCommitment(viewer, context.friOptions);

        bytes32[] memory transcript = deepTranscript(
            commitment,
            numPolys,
            points
        );
        bytes32 pow = proofOfWork(
            querySeed(transcript, context.friCommitment),
            nonce
        );
        if (!checkProofOfWork(pow, options.grindingBits)) {
            revert InsufficientProofOfWork();
        }

        (context.alpha, context.beta) = deepChallenges(transcript);
        context.pointValues = _pointValues(points, context.alpha);
        uint256 queries = numQueries(options.blowupLog2, options.grindingBits);
        (context.indices, context.inverses) = _queryIndices(
            points,
            pow,
            queries,
            context.domainSizeLog2
        );
        for (uint256 i = 0; i < queries; i++) {
            _verifyQuery(viewer, commitment, context, i);
        }
        viewer.close();
    }

    /// @dev Reads the parameters of the proof.
    function _readOptions(
        ProofViewer memory viewer
    ) private pure returns (DeepOptions memory options) {
        options.degreeBound = viewer.popVarint();
        options.blowupLog2 = viewer.popVarint();
        options.foldRate = viewer.popVarint();
        options.maxRounds = viewer.popVarint();
        options.grindingBits = viewer.popVarint();
    }

    /// @dev Checks the parameters like `Options::validate` and returns the base-2 logarithm of the
    ///   size of the extended evaluation domain.
    function _validateOptions(
        DeepOptions memory options
    ) private pure returns (uint256) {
        uint256 degreeBound = options.degreeBound;
        if (degreeBound == 0 || degreeBound & (degreeBound - 1) != 0) {
            revert FriVerifier.InvalidDegreeBound(degreeBound);
        }
        if (options.blowupLog2 == 0) {
            revert FriVerifier.InvalidBlowupFactor();
        }
        if (options.foldRate == 0) {
            revert FriVerifier.InvalidFoldRate();
        }
        uint256 degreeBoundLog2 = _log2(degreeBound);
        if (
            degreeBoundLog2 > BlueSky.S ||
            options.blowupLog2 > BlueSky.S - degreeBoundLog2
        ) {
            revert FriVerifier.DomainTooLarge(
                degreeBoundLog2,
                options.blowupLog2
            );
        }
        if (options.grindingBits > PROOF_OF_WORK_BITS) {
            revert InvalidGrindingBits(options.grindingBits);
        }
        return degreeBoundLog2 + options.blowupLog2;
    }

    /// @dev Performs the checks of `Commitment::from_proto` and checks the number of polynomials
    ///   of the proof against the commitment like `Proof::verify`.
    function _validateBatches(
        DeepCommitment memory commitment,
        uint256 numPolys
    ) private pure {
        DeepBatch[] memory batches = commitment.batches;
        if (batches.length == 0) {
            revert NoBatches();
        }
        uint256 expected = 0;
        for (uint256 b = 0; b < batches.length; b++) {
            expected += batches[b].numPolys;
        }
        if (numPolys != expected) {
            revert InvalidNumberOfPolynomials(numPolys, expected);
        }
    }

    /// @dev Reads the opened points, each with `numPolys` evaluations, and performs the checks of
    ///   `Proof::from_proto` and `Proof::verify` on them: there must be at least one, their
    ///   coordinates and evaluations must be canonical field elements, they must be sorted by
    ///   strictly increasing X-coordinate (the order of the `BTreeMap` of the Rust implementation),
    ///   and they must lie outside the evaluation domain.
    function _readPoints(
        ProofViewer memory viewer,
        uint256 numPolys,
        uint256 domainSizeLog2
    ) private view returns (DeepPoint[] memory points) {
        uint256 count = viewer.popVarint();
        if (count == 0) {
            revert NoPoints();
        }
        points = new DeepPoint[](count);
        // A point z is in the evaluation domain (a coset of the subgroup of order n shifted by the
        // multiplicative generator g) if and only if z^n = g^n.
        uint256 domainSize = 1 << domainSizeLog2;
        uint256 marker = BlueSky.MULTIPLICATIVE_GENERATOR.pow(domainSize);
        for (uint256 j = 0; j < count; j++) {
            uint256 z = viewer.popWord();
            _checkCanonical(z);
            if (j > 0 && z <= points[j - 1].z) {
                revert UnsortedPoints();
            }
            if (z.pow(domainSize) == marker) {
                revert PointInDomain(z);
            }
            uint256[] memory values = viewer.popWords(numPolys);
            for (uint256 i = 0; i < numPolys; i++) {
                _checkCanonical(values[i]);
            }
            points[j] = DeepPoint({z: z, values: values});
        }
    }

    /// @dev Reads the FRI commitment, whose number of roots is determined by the parameters, and
    ///   validates it with `FriVerifier.validateCommitment`.
    function _readFriCommitment(
        ProofViewer memory viewer,
        FriOptions memory friOptions
    ) private pure returns (FriCommitment memory commitment) {
        uint256 rounds = FriVerifier.numRounds(
            friOptions.degreeBound,
            friOptions.foldRate,
            friOptions.maxRounds
        );
        commitment.roots = new bytes32[](rounds);
        for (uint256 round = 0; round < rounds; round++) {
            commitment.roots[round] = viewer.popPoolWord();
        }
        commitment.foldedPolynomial = viewer.popWords(viewer.popVarint());
        FriVerifier.validateCommitment(friOptions, commitment);
    }

    /// @dev Returns the random linear combination with `alpha` of the evaluations at every point.
    function _pointValues(
        DeepPoint[] memory points,
        uint256 alpha
    ) private pure returns (uint256[] memory pointValues) {
        pointValues = new uint256[](points.length);
        for (uint256 j = 0; j < points.length; j++) {
            pointValues[j] = _linearCombination(points[j].values, alpha);
        }
    }

    /// @dev Derives the query indices from the proof of work, and returns them along with the
    ///   inverses of the denominators `x_i - z_j` of the DEEP quotients (see `Context.inverses`).
    function _queryIndices(
        DeepPoint[] memory points,
        bytes32 pow,
        uint256 queries,
        uint256 domainSizeLog2
    )
        private
        view
        returns (uint256[] memory indices, uint256[] memory inverses)
    {
        uint256 domainSize = 1 << domainSizeLog2;
        indices = new uint256[](queries);
        inverses = new uint256[](queries * points.length);
        for (uint256 i = 0; i < queries; i++) {
            uint256 index = queryIndex(pow, i, domainSize);
            indices[i] = index;
            // `Query::x`: the queried element of the shifted domain, g * omega^index.
            uint256 x = BlueSky.MULTIPLICATIVE_GENERATOR.mul(
                BlueSky.ROOT_OF_UNITY.pow(index << (BlueSky.S - domainSizeLog2))
            );
            for (uint256 j = 0; j < points.length; j++) {
                inverses[i * points.length + j] = x.sub(points[j].z);
            }
        }
        // None of the denominators is zero because the points are off the domain.
        BlueSky.invBatch(inverses);
    }

    /// @dev Reads and verifies the openings of the polynomial batches at the i-th query, computes
    ///   the combined DEEP quotient at the queried element, and reads and verifies the FRI query
    ///   against it.
    function _verifyQuery(
        ProofViewer memory viewer,
        DeepCommitment memory commitment,
        Context memory context,
        uint256 i
    ) private view {
        uint256 index = context.indices[i];
        uint256 combined = _verifyOpenings(
            viewer,
            commitment.batches,
            index,
            context
        );
        uint256 numPoints = context.pointValues.length;
        uint256 quotient = 0;
        uint256 power = BlueSky.ONE;
        for (uint256 j = 0; j < numPoints; j++) {
            uint256 term = combined.sub(context.pointValues[j]).mul(
                context.inverses[i * numPoints + j]
            );
            quotient = quotient.add(term.mul(power));
            power = power.mul(context.beta);
        }
        FriVerifier.verifyQuery(
            context.friOptions,
            viewer,
            index,
            context.friCommitment,
            quotient
        );
    }

    /// @dev Reads and verifies the Merkle proofs opening every batch at `index`, and returns the
    ///   random linear combination with `alpha` of all the opened values, in commitment order.
    ///   Every leaf has as many values as the polynomials of its batch, and they must be canonical
    ///   field elements.
    function _verifyOpenings(
        ProofViewer memory viewer,
        DeepBatch[] memory batches,
        uint256 index,
        Context memory context
    ) private pure returns (uint256 combined) {
        uint256 alpha = context.alpha;
        uint256 power = BlueSky.ONE;
        for (uint256 b = 0; b < batches.length; b++) {
            uint256 count = batches[b].numPolys;
            uint256 offset = viewer.skipWords(count);
            for (uint256 v = 0; v < count; v++) {
                uint256 value;
                assembly {
                    value := calldataload(add(offset, shl(5, v)))
                }
                _checkCanonical(value);
                combined = combined.add(value.mul(power));
                power = power.mul(alpha);
            }
            Merkle.verify(
                offset,
                count,
                viewer,
                context.domainSizeLog2,
                index,
                batches[b].root
            );
        }
    }

    /// @dev Returns the random linear combination of `values` with the powers of `alpha`, starting
    ///   from 1. Matches `deep::rlc`.
    function _linearCombination(
        uint256[] memory values,
        uint256 alpha
    ) private pure returns (uint256 result) {
        uint256 power = BlueSky.ONE;
        for (uint256 i = 0; i < values.length; i++) {
            result = result.add(values[i].mul(power));
            power = power.mul(alpha);
        }
    }

    /// @dev Reverts if `value` is not a canonical field element.
    function _checkCanonical(uint256 value) private pure {
        if (value >= BlueSky.P) {
            revert Merkle.NonCanonicalScalar(value);
        }
    }

    /// @dev Returns log2(n) for a power of 2 n.
    function _log2(uint256 n) private pure returns (uint256 result) {
        while (n > 1) {
            n >>= 1;
            result++;
        }
    }
}
